# Convex generated bindings and required AI guidance stay tracked so clean
# checkouts can compile and follow the repository's Convex authoring rules.

# Impeccable live mode config is source, but runtime journals are not.
.impeccable/live/sessions/
.impeccable/live/annotations/
.impeccable/live/server.json
.impeccable-live/
.impeccable-live.json

# Design/iteration artifacts, prototypes, and worktrees — generated, not source.
# Kept out of git and therefore out of Vercel/production deployments.
artifacts/
prototypes/
# Runtime prototype components are source and must remain version-controlled.
!src/components/prototypes/
!src/components/prototypes/**
docs/prototypes/
.claude/worktrees/
.git/worktrees/
outputs/

# Memtrace local daemon state + index data — machine-local runtime artifacts.
.memdb/
.memtrace/
