{
  "authKit": {
    "dev": {
      "configure": {
        "redirectUris": [
          "http://localhost:3000/callback",
          "https://drawflow.fairlend.ca/callback"
        ],
        "appHomepageUrl": "https://drawflow.fairlend.ca",
        "corsOrigins": ["http://localhost:3000", "https://drawflow.fairlend.ca"]
      },
      "localEnvVars": {
        "WORKOS_CLIENT_ID": "${authEnv.WORKOS_CLIENT_ID}",
        "WORKOS_API_KEY": "${authEnv.WORKOS_API_KEY}",
        "WORKOS_REDIRECT_URI": "http://localhost:3000/callback"
      }
    }
  }
}
